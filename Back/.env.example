# Backend Panadería Rincón
APP_ENV=development
APP_NAME="Panaderia API"
APP_VERSION=0.2.0
LOG_LEVEL=INFO
ENABLE_DOCS=1
CORS_ORIGINS=*
PORT=4000

# Supabase / PostgreSQL
# Usar Session pooler en Render, puerto 5432, sslmode=require.
DATABASE_URL="postgresql://postgres.PROJECT_REF:TU_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=8

# Seguridad
# Para desarrollo puede quedar AUTH_REQUIRED=0.
# Para producción real: poner AUTH_REQUIRED=1 y configurar API_KEY o usuarios/roles.
AUTH_REQUIRED=0
API_KEY=""
