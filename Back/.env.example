# Backend
APP_NAME="Panaderia API"
APP_ENV="development"
APP_VERSION="0.1.0"
PORT=4000
LOG_LEVEL="INFO"
ENABLE_DOCS="1"

# Frontend / CORS
# En desarrollo podés dejar *. En producción poné el dominio exacto del frontend.
CORS_ORIGINS="*"

# Supabase / PostgreSQL
# Recomendado para Supabase: usar Transaction Pooler puerto 6543 + sslmode=require
# Ejemplo:
# DATABASE_URL="postgresql://postgres.xxxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:6543/postgres?sslmode=require"
DB_POOL_MIN=1
DB_POOL_MAX=8
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=8

# Seguridad opcional para endpoints privados futuros.
# Si queda vacío, no exige API key.
API_KEY=""
